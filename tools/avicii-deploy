#!/bin/sh
# Build and flash postmarketOS for the OnePlus Nord (avicii).
# Usage:
#   avicii-deploy            - kernel and device package
#   avicii-deploy kernel     - kernel only
#   avicii-deploy device     - device package only (cmdline, deviceinfo)
#   avicii-deploy --no-flash - build and check, but do not flash
#   avicii-deploy --no-build - use packages already built (after a failed flash)

set -e
KERNEL=linux-oneplus-avicii
DEVICE=device-oneplus-avicii
EXPORT=/tmp/postmarketOS-export
PHONE=172.16.42.1

PKGS="$KERNEL $DEVICE"
FLASH=yes
BUILD=yes
for a in "$@"; do
	case "$a" in
		kernel)    PKGS="$KERNEL" ;;
		device)    PKGS="$DEVICE" ;;
		--no-flash) FLASH=no ;;
		--no-build) BUILD=no ;;
		*) echo "unknown argument: $a"; exit 1 ;;
	esac
done

step() { printf '\n\033[1;36m==> %s\033[0m\n' "$*"; }
warn() { printf '\033[1;33m    %s\033[0m\n' "$*"; }
die()  { printf '\n\033[1;31mERROR: %s\033[0m\n' "$*"; exit 1; }

step "Releasing stale mounts"
pmbootstrap shutdown >/dev/null 2>&1 || true

[ "$BUILD" = yes ] || { warn "build skipped (--no-build)"; PKGS_BUILD=""; }
for p in ${PKGS_BUILD-$PKGS}; do
	step "Checksums: $p"
	pmbootstrap checksum "$p"
	step "Building: $p"
	pmbootstrap build --force "$p"
done

step "Updating packages in the local rootfs chroot"
warn "otherwise export builds the image with the old kernel"
pmbootstrap chroot -r -- apk add -u $PKGS

if ping -c1 -W2 "$PHONE" >/dev/null 2>&1; then
	step "Phone is reachable - updating packages on it (kernel modules)"
	pmbootstrap sideload $PKGS || warn "sideload failed, continuing"
else
	warn "Phone is not reachable over the network - skipping sideload."
	warn "Kernel modules on the device stay from the previous build."
fi

step "Building the boot image"
pmbootstrap export

step "Checking the image before flashing"
python3 - "$EXPORT/boot.img" <<'PY' || die "image check failed"
import struct, re, sys, time, os
p = sys.argv[1]
d = open(p, "rb").read()
ks, = struct.unpack("<I", d[8:12])
ps, = struct.unpack("<I", d[36:40])
hv, = struct.unpack("<I", d[40:44])
m = re.search(rb'SMP PREEMPT .{,40}UTC 20\d\d', d[ps:ps+ks])
built = m.group(0).decode() if m else "?"
cl = d[64:576].split(b"\0")[0].decode(errors="replace")
age = (time.time() - os.path.getmtime(os.path.realpath(p))) / 60
print(f"    size:    {len(d)/1048576:.1f} MB (partition limit 96 MB)")
print(f"    kernel:  {built}")
print(f"    age:     {age:.0f} min")
print(f"    header:  v{hv}")
for name, token, want in (("console", "console=tty0", True),
                          ("rd.info", "rd.info", True),
                          ("splash",  "splash", False)):
    ok = (token in cl) == want
    print(f"    {name:8} {'ok' if ok else 'WRONG'}")
    if not ok: sys.exit(1)
if len(d) > 96*1024*1024: sys.exit(1)
if age > 30: print("    WARNING: the image is older than 30 min - the rebuild may not have reached it")
PY

[ "$FLASH" = yes ] || { step "Done (--no-flash)"; exit 0; }

step "Waiting for the phone in fastboot"
echo "    Put it there: power off, then hold Power + Volume Up"
n=0
until fastboot devices 2>/dev/null | grep -q .; do
	n=$((n+1)); [ "$n" -gt 120 ] && die "the phone did not show up in fastboot"
	sleep 2
done
echo "    device: $(fastboot devices)"

step "Flashing both slots"
warn "both, so that a slot switch does not boot Android"
fastboot flash boot_a "$EXPORT/boot.img"
fastboot flash boot_b "$EXPORT/boot.img"

step "Rebooting"
fastboot reboot

step "Waiting for the system to boot"
n=0
until ping -c1 -W2 "$PHONE" >/dev/null 2>&1; do
	n=$((n+1)); [ "$n" -gt 90 ] && die "the phone did not come up in three minutes"
	sleep 2
done
echo "    network is up, waiting for sshd"
n=0
until (echo > /dev/tcp/$PHONE/22) 2>/dev/null; do
	n=$((n+1)); [ "$n" -gt 90 ] && { warn "sshd did not come up, but the network is up"; break; }
	sleep 2
done

step "State after boot"
ssh -o BatchMode=yes -o ConnectTimeout=8 user@$PHONE '
	echo "    kernel:  $(uname -r) $(uname -a | grep -oE "UTC 20[0-9]{2}")"
	echo "    load:    $(cut -d" " -f1-3 /proc/loadavg)"
	d=$(ps -eo stat,comm | awk "\$1 ~ /^D/ {print \$2}" | tr "\n" " ")
	echo "    in D state: ${d:-none}"
' 2>/dev/null || warn "no answer over SSH - check by hand"

step "Done"
